# TypeForge Web — Environment Variables
# Local development can use local values. Production values are configured in Vercel.

# Clerk Authentication
PUBLIC_CLERK_PUBLISHABLE_KEY=<set-in-vercel>
CLERK_SECRET_KEY=<set-in-vercel>

# API URL (for SSR)
API_URL=http://localhost:8787

# SEO / analytics
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_ENABLE_ANALYTICS=false
PUBLIC_PLAUSIBLE_DOMAIN=typingscholar.com

# Error tracking (Sentry).
# Leave empty to disable: the SDK stays inert without a DSN, which is what local
# development and CI rely on. The browser DSN is public by design; the server DSN
# is the same value and is read from process.env at start-up.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=

# Environment
ENVIRONMENT=development
