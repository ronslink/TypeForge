# TypeForge Environment Variables

# Node Environment
NODE_ENV="development"

# Database Connection
# Connect to Hetzner Postgres DB (157.180.84.79)
DATABASE_URL="postgresql://<user>:<password>@157.180.84.79:5432/<dbname>"

# Stripe Integration
STRIPE_SECRET_KEY="<set-in-vercel>"
STRIPE_WEBHOOK_SECRET="whsec_..."

# Clerk Authentication
# Production values must come from the matching Clerk production instance in Vercel.
CLERK_SECRET_KEY="<set-in-vercel>"
PUBLIC_CLERK_PUBLISHABLE_KEY="<set-in-vercel>"

# Error tracking (Sentry) — server side.
# `apps/web` reads SENTRY_DSN at start-up and PUBLIC_SENTRY_DSN in the browser.
# With neither set, the SDK is inert and no events are sent.
SENTRY_DSN=
# Optional: overrides the environment tag (defaults to VERCEL_ENV, then NODE_ENV).
SENTRY_ENVIRONMENT=
