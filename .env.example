# TypeForge Environment Variables

# Node Environment
NODE_ENV="development"

# Database Connection
# Managed PostgreSQL (DigitalOcean). Always sslmode=require.
#
# Serverless deployments should use the *pooled* port (25061), not the direct one
# (25060): each function instance opens its own pool, and the direct port will
# exhaust the cluster's connection limit.
#
# The old Hetzner host (157.180.84.79) is gone — its Postgres cluster crashed on
# 2026-10-02 when the root filesystem filled and could not restart. Do not point
# anything at it. See docs/database-cutover.md.
DATABASE_URL="postgresql://<user>:<password>@<cluster-host>:25061/typeforge?sslmode=require"

# Stripe Integration
STRIPE_SECRET_KEY="<set-in-vercel>"
STRIPE_WEBHOOK_SECRET="whsec_..."

# Clerk Authentication
# Production values must come from the matching Clerk production instance in Vercel.
CLERK_SECRET_KEY="<set-in-vercel>"
PUBLIC_CLERK_PUBLISHABLE_KEY="<set-in-vercel>"

# Error tracking (Sentry) — server side.
# `apps/web` reads SENTRY_DSN at start-up and PUBLIC_SENTRY_DSN in the browser.
# With neither set, the SDK is inert and no events are sent.
SENTRY_DSN=
# Optional: overrides the environment tag (defaults to VERCEL_ENV, then NODE_ENV).
SENTRY_ENVIRONMENT=
